# Copy to .env and fill in the two required values, then run: docker compose up
# Variables marked (later) are documented now but take effect in a later milestone.

# --- Required ---------------------------------------------------------------
# Postgres password, used by both the db and app services.
DB_PASSWORD=change-me-db-password
# Dashboard login password. The app refuses to start if empty or shorter than 12 characters.
TRACKER_ADMIN_PASSWORD=change-me-to-12-plus-chars

# --- Database (only change these when using your own Postgres) --------------
# JDBC URL. docker-compose.yml sets this to the bundled db service.
# SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/llmtracker
# Database user.
# SPRING_DATASOURCE_USERNAME=tracker
# Database password. docker-compose.yml sets this from DB_PASSWORD.
# SPRING_DATASOURCE_PASSWORD=

# --- Proxy ------------------------------------------------------------------
# Reject proxy calls without a valid X-Tracker-Key. Never expose the proxy publicly with this off.
# TRACKER_REQUIRE_PROJECT_KEY=true
# OpenAI upstream base URL.
# TRACKER_OPENAI_BASE_URL=https://api.openai.com/v1
# Anthropic upstream base URL.
# TRACKER_ANTHROPIC_BASE_URL=https://api.anthropic.com
# Extra OpenAI-compatible providers as name=url pairs, comma separated. Reach them at /proxy/{name}.
# Names: lowercase letters, digits, dashes. A malformed entry stops the app at startup.
# TRACKER_CUSTOM_PROVIDERS=groq=https://api.groq.com/openai/v1,local=http://ollama:11434/v1
# Upstream connect timeout.
# TRACKER_CONNECT_TIMEOUT=10s
# Upstream response timeout.
# TRACKER_UPSTREAM_TIMEOUT=10m
# Largest request body the proxy accepts; larger requests get 413.
# TRACKER_MAX_REQUEST_BODY=20MB
# (later) Add stream_options.include_usage to streamed OpenAI Chat Completions (clients get one extra final chunk).
# TRACKER_OPENAI_INJECT_STREAM_USAGE=true

# --- Attribution (later) ----------------------------------------------------
# Discover agents automatically from a SHA-256 fingerprint of the system prompt.
# TRACKER_FINGERPRINT_ENABLED=true
# Mask numbers, UUIDs, ISO dates and emails before fingerprinting so templated prompts stay one agent.
# TRACKER_FINGERPRINT_MASK=false

# --- Recording --------------------------------------------------------------
# In-memory usage event queue size; events are dropped (and counted in tracker.events.dropped) when full.
# TRACKER_QUEUE_CAPACITY=10000

# --- Budgets and alerts (later) ---------------------------------------------
# Time zone in which daily and monthly budget periods start (use current names, e.g. Asia/Kolkata).
# TRACKER_TIMEZONE=UTC
# Slack-compatible webhook that receives budget alerts as JSON.
# TRACKER_ALERTS_WEBHOOK_URL=

# --- Server -----------------------------------------------------------------
# HTTP port inside the container (the compose file publishes 8080).
# SERVER_PORT=8080
